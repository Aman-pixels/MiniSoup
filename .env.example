# MiniSoup Environment Configuration

# LLM API Keys (Gemini is active by default; Claude is supported as well)
GEMINI_API_KEY="your-gemini-api-key-here"
ANTHROPIC_API_KEY=""

# Voyage AI Embeddings (for AST semantic codebase retrieval)
VOYAGE_API_KEY="your-voyage-api-key-here"

# Model Selection
PLANNER_MODEL="gemini-2.5-flash"
EXECUTOR_MODEL="gemini-2.5-flash"
REVIEWER_MODEL="gemini-2.5-flash"

# Docker Sandbox Execution
DOCKER_IMAGE="python:3.11-slim"
SANDBOX_TIMEOUT_SECONDS="120"
MAX_ITERATIONS="4"
